# Frontend (Vite). Copy this file to frontend/.env and fill in real values.
#
# Only variables prefixed with VITE_ are exposed to browser code, and
# everything here IS shipped to the browser — never put a secret in this
# file. The Supabase anon key is designed to be public; the service-role
# key is not and must never appear here.

# Base URL of the Grove backend.
# Leave EMPTY for local development: requests then go to the Vite dev
# server's /api proxy (see vite.config.js), which forwards to Flask on
# :5000 and avoids CORS entirely.
# In production set it to the deployed API origin, e.g.
#   VITE_API_URL=https://grove-api.onrender.com
VITE_API_URL=

# Supabase project URL (Supabase dashboard > Settings > API > Project URL).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase anonymous/public key (same page, "anon public").
VITE_SUPABASE_ANON_KEY=
