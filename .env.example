# Backend (Flask). Copy this file to .env and fill in real values.
# Without DATABASE_URL set, the backend falls back to a local SQLite
# file (grove.db) with zero setup.

# Supabase Postgres connection string (Settings > Database > Connection
# string > Transaction pooler, in your Supabase project).
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# turner, the url I used was 5432:
# or format: DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# might help for debugging
