# Backend (Flask). Copy this file to .env and fill in real values.
# Every value here is optional for a first local run: with none of them set
# the backend boots against a local SQLite file (grove.db) with zero setup.

# ── Database ────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Supabase dashboard >
# Settings > Database > Connection string > Transaction pooler).
# Leave unset to use the local SQLite fallback.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Authentication ──────────────────────────────────────────────────────
# The HS256 secret Supabase signs its access tokens with (Supabase dashboard >
# Settings > API > JWT Settings > JWT Secret).
#
# REQUIRED IN PRODUCTION. When it is set, every protected endpoint verifies
# the caller's `Authorization: Bearer <token>` and derives their identity
# from the verified token. When it is NOT set, the backend runs in
# "trusted-client" mode — it believes whatever supabase_id the request
# claims — which is fine for local development and unacceptable anywhere
# else. Startup logs a loud warning in that case.
SUPABASE_JWT_SECRET=

# ── App environment ─────────────────────────────────────────────────────
# development | testing | production. Controls debug mode, log format, and
# whether trusted-client auth is allowed to boot at all.
FLASK_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# "*" is only honoured outside production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Emit one JSON object per log line instead of human-readable text.
# Defaults to on in production, off elsewhere.
# LOG_JSON=true

# ── Frontend ────────────────────────────────────────────────────────────
# The frontend reads its own values from frontend/.env — see
# frontend/.env.example. They are listed here only so the full set of
# configuration for the project is visible in one place.
#   VITE_API_URL
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
